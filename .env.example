# cp .env.example .env 후 값을 채운다. .env 는 git에 올리지 않는다.
# 비워 둔 항목은 docker-compose.yml 의 기본값(localhost 개발용)을 쓴다. 표는 README 환경변수 절 참고.

COMPOSE_PARALLEL_LIMIT=1
DOCKER_BUILDKIT=1

# backend
SPRING_PROFILE=satc
CORS_ALLOWED_ORIGINS=
DOCS_AUTH_TOKEN_SECRET=
DOCS_AUTH_TOKEN_TTL=12h
DOCS_AUTH_ADMIN_USERNAME=
DOCS_AUTH_ADMIN_PASSWORD=
DOCS_AUTH_DEV_ACCOUNTS=false
DOCS_OAUTH_ISSUER=
DOCS_OAUTH_CONSENT_URL=
DOCS_OAUTH_TOKEN_TTL=168h
DOCS_OAUTH_ALLOWED_REDIRECT_URIS=
EXTERNAL_API_ENABLED=true

# frontend
VITE_API_BASE_URL=
VITE_JENKINS_URL=
VITE_ARGOCD_URL=
VITE_COMMON_CODE_URL=

# indexing 검색 저장소 (README 환경변수 절)
SEARCH_BACKEND=es
SEARCH_DUAL_WRITE=false
SEARCH_PG_TEXT_INDEX=pgroonga

# postgres / minio
POSTGRES_DB=docs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# 테이블을 둘 스키마. 비우면 public. 운영(docs/deploy.md)처럼 나누려면 두 값을 같게 docs_portal 로 둔다
DOCS_DB_SCHEMA=
SEARCH_PG_SCHEMA=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=docs

# 파일 저장소(S3 호환, backend·indexing 공통). 비우면 위 minio 컨테이너와 MINIO_* 값을 쓴다.
# Supabase Storage 예시와 각 항목 설명은 docs/storage.md 참고
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=
STORAGE_MANAGE_BUCKET=
STORAGE_PUBLIC_READ=
STORAGE_ASCII_KEYS=
# 업로드 상한 (기본 파일 50MB, 요청 100MB)
DOCS_MAX_UPLOAD_SIZE=
DOCS_MAX_REQUEST_SIZE=
